{
  "name": "kamil-shopping-organizer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "validate": "node scripts/validate.mjs",

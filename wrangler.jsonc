{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kamil-shopping-organizer",
  "main": "worker/index.ts",
  // Worker in front of the static site. Today’s date for this script.
  "compatibility_date": "2026-10-24",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Every request, including HTML and shopping.json, hits worker/index.ts first.
    "run_worker_first": true
  },
  // `wrangler deploy` with no --env uses THIS top-level config, not env.production.
  // ENVIRONMENT is production, so a bare deploy stays Access-only and fail-closed.
  // POLICY_AUD is not committed. GitHub Actions passes it with --var. Without it
  // the Worker returns 500. vars do not inherit into named environments.
  // GROK_WEBHOOK_URL, GROK_WEBHOOK_KEY, and GROK_WEBHOOK_AUTH are Worker secrets.
  // Actions uploads each one only when that GitHub secret is set. When
  // GROK_WEBHOOK_AUTH is set it is the Authorization value. Otherwise
  // GROK_WEBHOOK_KEY_HEADER is an optional plain var; the default is
  // Authorization: Bearer <key>.
  "vars": {
    "ENVIRONMENT": "production",
    "TEAM_DOMAIN": "https://staho.cloudflareaccess.com"
  },
  "routes": [{ "pattern": "shopping-organizer.staho.dev", "custom_domain": true }],
  "env": {
    "production": {
      // Keep the live script name. Without this, Wrangler would publish
      // kamil-shopping-organizer-production.
      "name": "kamil-shopping-organizer",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "ENVIRONMENT": "production",
        "TEAM_DOMAIN": "https://staho.cloudflareaccess.com"
      },
      "routes": [{ "pattern": "shopping-organizer.staho.dev", "custom_domain": true }]
    },
    "test": {
      // Separate script. Basic Auth only. Empty routes stop this env from
      // inheriting the live custom domain.
      "name": "kamil-shopping-organizer-test",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [],
      "vars": {
        "ENVIRONMENT": "test"
      },
      // Deploy fails until both secrets exist. Local `wrangler dev --env test` only warns.
      "secrets": {
        "required": ["BASIC_AUTH_USER", "BASIC_AUTH_PASS"]
      }
    }
  }
}
